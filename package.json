{
  "name": "bolt-transfer",
  "version": "1.0.0",
  "description": "WiFi file sharing Electron app using HTTP protocol",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "electron-store": "^10.1.0",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "network-address": "^1.1.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.2"
  },
  "build": {
    "appId": "com.bolt.transfer",
    "productName": "Bolt Transfer",
    "files": [
      "main.js",
      "index.html",
      "receive.html",
      "receive.js",
      "mobile-upload.html",
      "chatbot.html",
      "chatbot.js",
      "chatbot.css",
      "settings.html",
      "settings.js",
      "settings.css",
      "assets/**/*"
    ],
    "directories": {
      "output": "appFinal"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/lightning_app.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
